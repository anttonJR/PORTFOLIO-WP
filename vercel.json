{
  "rewrites": [
    {
      "source": "/contact/",
      "destination": "/contact/index.html"
    },
    {
      "source": "/works/",
      "destination": "/works/index.html"
    },
    {
      "source": "/hello-world/",
      "destination": "/hello-world/index.html"
    },
    {
      "source": "/category/:path*/",
      "destination": "/category/:path*/index.html"
    },
    {
      "source": "/feed/",
      "destination": "/index.html"
    },
    {
      "source": "/comments/feed/",
      "destination": "/index.html"
    },
    {
      "source": "/wp-json/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/contact",
      "destination": "/contact/",
      "permanent": false
    },
    {
      "source": "/works",
      "destination": "/works/",
      "permanent": false
    },
    {
      "source": "/hello-world",
      "destination": "/hello-world/",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/about/",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "trailingSlash": true,
  "cleanUrls": false
}

